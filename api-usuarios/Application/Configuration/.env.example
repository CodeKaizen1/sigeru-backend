# Copiar este archivo a ".env" (en esta misma carpeta) y completar con los
# datos reales de conexión de cada máquina. El ".env" nunca se sube al
# repositorio (ver .gitignore) - Conexion.php lo lee automáticamente y, si
# no lo encuentra, usa localhost/root/sin-contraseña como respaldo (el
# XAMPP por defecto).
DB_HOST=localhost
DB_NAME=SiGeRU
DB_USER=root
DB_PASS=
# DB_PORT es opcional: si no se define, se usa 3306 (el puerto estándar de
# MySQL / XAMPP). Solo hace falta completarlo si tu MySQL corre en otro
# puerto (por ejemplo, una VM de base de datos externa con un puerto no
# estándar).
DB_PORT=3306

# SMTP para mandar mails reales (hoy solo recuperación de contraseña, ver
# recuperarPassword en index.php). Mailer.php los lee del mismo modo.
# SMTP_USER/SMTP_PASS: la cuenta de Gmail dedicada a SiGeRU y una
# "Contraseña de aplicación" generada en myaccount.google.com/apppasswords
# (la contraseña normal de Gmail NO funciona acá). Si se dejan vacíos,
# Mailer simplemente no manda el mail (lo loguea) en vez de romper el
# endpoint.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SiGeRU

# Base del frontend-usuarios, para armar el link de reseteo dentro del
# mail. El valor de abajo es el que corresponde a una instalación XAMPP
# típica de este proyecto (frontend-usuarios como hermano de api-usuarios
# en htdocs) -- normalmente no hace falta tocarlo.
FRONTEND_USUARIOS_URL=http://localhost/frontend-usuarios
