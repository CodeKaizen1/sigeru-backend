# Copiar este archivo a ".env" (en esta misma carpeta) y completar con los
# datos reales de cada máquina. El ".env" nunca se sube al repositorio
# (el .gitignore de la raíz ya ignora cualquier archivo ".env") -- esta
# API no tenía hasta ahora ningún .env.example propio porque Conexion.php
# solo necesitaba el de DB (con defaults de XAMPP: localhost/root/sin
# contraseña), pero el captcha real y el mail de confirmación opcionales
# (pedido de Matías, 16/10/2026) sí necesitan credenciales de verdad.

# DB: mismo criterio que api-usuarios/Application/Configuration/.env --
# si no se completa, Conexion.php usa localhost/root/sin-contraseña
# (el XAMPP por defecto).
DB_HOST=localhost
DB_NAME=SiGeRU
DB_USER=root
DB_PASS=
# DB_PORT es opcional: si no se define, se usa 3306 (el puerto estándar de
# MySQL / XAMPP). Solo hace falta completarlo si tu MySQL corre en otro
# puerto (por ejemplo, una VM de base de datos externa con un puerto no
# estándar).
DB_PORT=3306

# Captcha real del formulario público de incidencia (ver
# VerificadorCaptcha.php). El valor de abajo es la SECRET KEY DE PRUEBA
# pública de Cloudflare (siempre aprueba cualquier token, documentada en
# developers.cloudflare.com/turnstile/troubleshooting/testing) -- sirve
# para probar que todo el circuito funciona de punta a punta (frontend ->
# Cloudflare -> este backend) SIN tener que darte de alta todavía.
#
# Antes de dejar esto en producción: date de alta gratis en
# dash.cloudflare.com/sign-up, agregá un sitio en Turnstile, y reemplazá
# ESTE valor por tu Secret Key real -- y en
# sigeru-frontend/landing/index.html, el data-sitekey del div
# "cf-turnstile" por tu Site Key real (esa SÍ es pública, va en el HTML
# sin problema). Si dejás este campo vacío, VerificadorCaptcha deja pasar
# los reportes sin verificar nada (ver su propio comentario) -- no te
# vas a dar cuenta de que no está protegiendo nada hasta que alguien
# abuse del formulario, así que no conviene dejarlo vacío por mucho tiempo.
#
# Matías ya se dio de alta (16/10/2026, widget "SiGeRU", hostname
# localhost) y completó su Secret Key real en SU PROPIO .env (este
# archivo .env.example se queda con la de prueba a propósito, es la
# plantilla para cualquier otra máquina/clon del repo).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP para el mail de confirmación OPCIONAL del reporte de incidencia
# (si el vecino completa "Correo electrónico" en el formulario público).
# Mismo formato que usa api-usuarios para "Recuperar contraseña" -- de
# hecho, podés usar la MISMA cuenta de Gmail dedicada y la MISMA
# "Contraseña de aplicación" (generada en
# myaccount.google.com/apppasswords, la contraseña normal de Gmail NO
# funciona acá) en las 2 APIs. Si se dejan vacíos, Mailer simplemente no
# manda el mail (lo loguea) en vez de romper el endpoint -- la incidencia
# igual queda creada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SiGeRU
