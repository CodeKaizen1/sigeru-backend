# Variable para "docker compose up" (NO es el .env de cada API en
# Application/Configuration/.env - esos siguen existiendo aparte, para
# cuando el proyecto corre en XAMPP en vez de Docker). docker-compose.yml
# la usa para el usuario root de MySQL, tanto para crear la base como
# para que las 3 APIs se conecten adentro del contenedor "web" - antes
# esta contraseña estaba escrita directo en docker-compose.yml y en
# docker/env/*.env (ítem 11 de seguridad, 06/10/2026: sacarla del repo).
#
# Copiá este archivo a ".env" (mismo directorio que docker-compose.yml,
# o sea la raíz de este repo) y poné una contraseña real -
# "docker compose up" la lee sola, no hace falta exportar nada a mano.
MYSQL_ROOT_PASSWORD=cambiar_esta_contrasenia
